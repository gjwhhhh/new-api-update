# Copy to .env or .env.development.local and adjust if needed.
# Browser entry is always http://localhost:3001 — do not open the Go port in a browser.
#
# Local Go backend and Docker Compose backend (default):
VITE_REACT_APP_SERVER_URL=http://127.0.0.1:3000
#
# To use another backend port, override this value in .env.development.local.
